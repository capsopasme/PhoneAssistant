<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- find songs by name for Gramophone -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- the memory job waits for a network: JobScheduler refuses a network constraint without it -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- voice call: a microphone foreground service that keeps going with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- earpiece / Bluetooth headset routing (communication mode) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- the time-stop effect's thud -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the memory job (distilling finished calls) survives a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- personal app: open any installed app by name -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- the system TTS engine (MOSS-TTS-Nano) for the voice call -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Settings">

        <!-- launcher icon opens the settings -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- long-press the icon: "语音通话" -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          The assistant sheet. ACTION_ASSIST makes this app selectable as the default digital
          assistant (corner swipe / long-press home). Transient: no recents entry, no history,
          its own task so it never drags another app's task around.
        -->
        <activity
            android:name=".ui.AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=".assist"
            android:theme="@style/Theme.Assist"
            android:windowSoftInputMode="adjustNothing|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.capsopasme.assistant.START" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The voice call screen: its own task, shown over the lock screen (like an incoming-call
          screen), gone from recents when the call ends.
        -->
        <activity
            android:name=".call.CallActivity"
            android:autoRemoveFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=".call"
            android:theme="@style/Theme.Call"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="com.capsopasme.assistant.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Quick Settings tiles: a way in on every ROM (ColorOS has no corner swipe for the
          assistant). Bound by the system only while the panel shows them.
        -->
        <service
            android:name=".ui.AssistTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_assist"
            android:label="@string/tile_assist"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".ui.CallTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_call"
            android:label="@string/tile_call"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- what 噜噜 remembers: view and delete -->
        <activity
            android:name=".ui.MemoryActivity"
            android:exported="false" />

        <!-- distills finished calls into 噜噜's memory once there is a network -->
        <service
            android:name=".memory.MemoryJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- the voice call itself: listen / think / speak, also with the screen off -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          Offline recognizer (sherpa-onnx + Qualcomm QNN), isolated in its own process:
          native failures during model initialization call exit() and must not take the UI down.
        -->
        <service
            android:name=".asr.AsrService"
            android:exported="false"
            android:process=":asr" />

        <!-- FastRPC library on Qualcomm devices, needed by the QNN HTP backend -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
    </application>
</manifest>
