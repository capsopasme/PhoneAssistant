<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- bottom sheet over whatever app is open -->
    <style name="Theme.Assist" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- the sheet animates itself (AssistActivity.playEnter / dismiss) -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!--
      full-screen voice call, over the lock screen too. Starts translucent so the time-stop effect
      can grab the screen behind it (no splash window either); CallActivity makes itself opaque
      right away, or once the effect has played. The layout paints its own background.
    -->
    <style name="Theme.Call" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Theme.Settings" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/card</item>
        <!--
          edge-to-edge is forced at targetSdk 36 and the bars are transparent over the white
          card: without this the status bar icons are white on white (only the battery
          percentage stayed readable)
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
