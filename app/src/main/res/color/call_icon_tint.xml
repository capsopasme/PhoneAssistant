<?xml version="1.0" encoding="utf-8"?>
<!-- icon on a call screen button: white on the filled ("on") state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#FFFFFFFF" android:state_activated="true" />
    <item android:alpha="0.38" android:color="@color/call_button_icon" android:state_enabled="false" />
    <item android:color="@color/call_button_icon" />
</selector>
