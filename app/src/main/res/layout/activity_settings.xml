<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- focusable itself: takes the initial focus, so no field (and no keyboard) is active on open -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="语音助手"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- voice call entry -->
        <LinearLayout
            android:id="@+id/callEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_call_entry"
            android:clickable="true"
            android:contentDescription="和噜噜通话"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_call_entry_icon"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call"
                android:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="和噜噜通话"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/callEntrySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="肥嘟嘟的噜噜，随时陪你聊"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- entry -->
        <TextView style="@style/SectionTitle" android:text="唤起方式" />

        <TextView
            android:id="@+id/roleStatus"
            style="@style/Body" />

        <LinearLayout style="@style/ButtonRow">
            <Button
                android:id="@+id/roleRoot"
                style="@style/RowButton"
                android:text="设为默认助理（root）" />
            <Button
                android:id="@+id/roleSettings"
                style="@style/RowButton"
                android:text="打开系统设置" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="手势导航下从屏幕左下角或右下角斜向上滑唤起（系统设置 → 系统 → 手势 → 系统导航 → 手势导航旁的齿轮 → 打开“滑动调用助理”）。\nQuickBall 等应用可启动 Intent 动作 com.capsopasme.assistant.START。" />

        <!-- llm -->
        <TextView style="@style/SectionTitle" android:text="大模型" />

        <TextView style="@style/Label" android:text="使用哪个模型（只用选中的这一个，出错不会换别的）" />
        <RadioGroup
            android:id="@+id/llmGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/Label" android:text="DeepSeek API Key" />
        <EditText
            android:id="@+id/deepseekKey"
            style="@style/Field"
            android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="DeepSeek 模型" />
        <EditText
            android:id="@+id/deepseekModel"
            style="@style/Field"
            android:hint="deepseek-flash" />

        <TextView style="@style/Label" android:text="智谱 GLM API Key（open.bigmodel.cn）" />
        <EditText
            android:id="@+id/glmKey"
            style="@style/Field"
            android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="GLM 模型（glm-4.7-flash 免费）" />
        <EditText
            android:id="@+id/glmModel"
            style="@style/Field"
            android:hint="glm-4.7-flash" />

        <TextView style="@style/Label" android:text="Gemini API Key" />
        <EditText
            android:id="@+id/geminiKey"
            style="@style/Field"
            android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="Gemini 模型" />
        <EditText
            android:id="@+id/geminiModel"
            style="@style/Field"
            android:hint="gemini-3.8-flash" />

        <TextView style="@style/Label" android:text="查天气的默认城市" />
        <EditText
            android:id="@+id/defaultCity"
            style="@style/Field"
            android:hint="例如：杭州" />

        <!-- speech -->
        <TextView style="@style/SectionTitle" android:text="语音识别（离线）" />

        <RadioGroup
            android:id="@+id/modelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/modelStatus"
            style="@style/Body" />

        <ProgressBar
            android:id="@+id/modelProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:visibility="gone" />

        <LinearLayout style="@style/ButtonRow">
            <Button
                android:id="@+id/modelCopy"
                style="@style/RowButton"
                android:text="从小企鹅复制" />
            <Button
                android:id="@+id/modelDownload"
                style="@style/RowButton"
                android:text="下载" />
        </LinearLayout>

        <LinearLayout style="@style/ButtonRow">
            <Button
                android:id="@+id/modelImport"
                style="@style/RowButton"
                android:text="导入 .tar.bz2" />
            <Button
                android:id="@+id/modelTest"
                style="@style/RowButton"
                android:text="测试" />
            <Button
                android:id="@+id/modelDelete"
                style="@style/RowButton"
                android:text="删除" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="下载加速前缀（可不填，如 https://ghfast.top/）" />
        <EditText
            android:id="@+id/mirror"
            style="@style/Field"
            android:inputType="textUri" />

        <TextView style="@style/Label" android:text="说完后停顿多久算结束（毫秒，300–2000）" />
        <EditText
            android:id="@+id/silence"
            style="@style/Field"
            android:inputType="number" />

        <Switch
            android:id="@+id/keepLoaded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="用完后保留模型（推荐）"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            style="@style/Hint"
            android:text="保留时识别进程会被系统冻结在后台缓存里，不占 CPU、不耗电，内存紧张时系统会自动回收；下次唤起不用重新加载。关闭则每次用完立即释放。" />

        <!-- voice call -->
        <TextView style="@style/SectionTitle" android:text="噜噜（语音通话）" />

        <TextView
            style="@style/Hint"
            android:text="像打电话一样和噜噜连续聊天：一只肥嘟嘟的小猪，情绪超稳定，懂你的感受，也能答疑解惑、帮你上网查最新消息，但不操作手机（设闹钟、开关这些请用语音助手卡片）。\n进入：本页顶部的“和噜噜通话”、卡片右上角的电话按钮、在卡片里说“噜噜”“叫噜噜来”“陪我聊聊”或“进入通话模式”、长按桌面图标；QuickBall 等应用可启动 Intent 动作 com.capsopasme.assistant.CALL。\n退出：说“退出通话”“挂了吧”“拜拜”“晚安”，说“切回助手”会挂断并打开助手卡片。熄屏照常进行，很久没人说话或来电时自动结束。" />

        <TextView style="@style/Label" android:text="朗读用的语音合成（系统首选 TTS 引擎）" />

        <TextView
            android:id="@+id/ttsStatus"
            style="@style/Body" />

        <LinearLayout style="@style/ButtonRow">
            <Button
                android:id="@+id/ttsSettings"
                style="@style/RowButton"
                android:text="系统 TTS 设置" />
            <Button
                android:id="@+id/ttsTest"
                style="@style/RowButton"
                android:text="试听" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="通话里说完后停顿多久算一句结束（毫秒，300–2000）" />
        <EditText
            android:id="@+id/callSilence"
            style="@style/Field"
            android:inputType="number" />

        <TextView style="@style/Label" android:text="多久没人说话自动挂断（秒，0 = 不自动挂断）" />
        <EditText
            android:id="@+id/callIdle"
            style="@style/Field"
            android:inputType="number" />

        <Switch
            android:id="@+id/callCue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="轮到你说话时响一声"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            style="@style/Hint"
            android:text="只在熄屏或离开通话界面时响；看着通话界面时用圆球的动画提示。" />

        <Switch
            android:id="@+id/callHeadsetMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="连着蓝牙耳机时用耳机的麦克风"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            style="@style/Hint"
            android:text="打开：像打电话一样走蓝牙通话通道，手机放口袋里也听得清你说话，但朗读变成通话音质。关闭：朗读以高音质走耳机，用手机自己的麦克风听你说话。" />

        <!-- memory -->
        <Switch
            android:id="@+id/memoryEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="噜噜记住聊过的事（无感记忆）"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            style="@style/Hint"
            android:text="每次挂断后，联网时用上面选的大模型把这次通话整理成几条关于你的记忆和一句摘要；下次通话噜噜会自然地记得，偶尔主动问问你之前说过的事。说“记住…”当场记，说“忘掉…”当场删。只存在手机里，不记密码、验证码、证件号和银行卡号。关闭后不再记录，已有的记忆可以在下面清空。" />

        <TextView
            android:id="@+id/memoryStatus"
            style="@style/Body" />

        <LinearLayout style="@style/ButtonRow">
            <Button
                android:id="@+id/memoryManage"
                style="@style/RowButton"
                android:text="查看和管理" />
            <Button
                android:id="@+id/memoryClear"
                style="@style/RowButton"
                android:text="全部清空" />
        </LinearLayout>

        <!-- looks -->
        <TextView style="@style/SectionTitle" android:text="特效" />

        <Switch
            android:id="@+id/timeStopFx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="时停特效（进出助手卡片和通话）"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            style="@style/Hint"
            android:text="唤出助手或开始通话时，一下重震，一个反相的球从中心炸开，扫过之后整个屏幕定格、褪色，时间像停住了一样；关闭卡片或挂断时反向恢复。需要 root 截一张当前屏幕（只在内存里，用完即丢，不保存）；禁止截屏的应用里换成简化版。只震动，不出声；开麦不等动画，张嘴就能说。" />

        <!-- permissions -->
        <TextView style="@style/SectionTitle" android:text="权限" />

        <TextView
            android:id="@+id/permStatus"
            style="@style/Body" />

        <LinearLayout style="@style/ButtonRow">
            <Button
                android:id="@+id/permRequest"
                style="@style/RowButton"
                android:text="授予权限" />
            <Button
                android:id="@+id/rootCheck"
                style="@style/RowButton"
                android:text="检查 root" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="麦克风：语音输入。通讯录：按姓名打电话/发短信。电话：确认后直接拨出（不授予则只打开拨号盘）。音乐：按歌名在本地曲库里找歌交给留声机播放。root：系统开关、亮度、锁屏。" />
    </LinearLayout>
</ScrollView>
